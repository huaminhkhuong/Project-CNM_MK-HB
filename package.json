{
  "name": "cnm-mk-hb",
  "private": true,
  "version": "0.1.0",
  "description": "E-commerce system for computers and accessories with AI customer support module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node scripts/bootstrap-master.js",
    "setup": "node scripts/bootstrap-master.js",
    "bootstrap": "node scripts/bootstrap-master.js",
    "dev": "node scripts/dev.js",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "check:all": "cd services/api && npx tsc --noEmit && cd ../apps/web && npx vite build && cd ../.. && npx playwright test e2e/pc-builder-qa-checklist.spec.ts",
    "dev:api": "npm run dev -w services/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -ws",
    "lint": "npm run lint -ws",
    "test": "npm test -w services/api",
    "test:api": "npm test -w services/api",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed:production": "npm run seed:production -w services/api",
    "smoke:sales": "node test-sales-flow.js",
    "seed:guest-demo": "npm run seed:guest-demo -w services/api",
    "prod:create-env": "node scripts/production/create-env.js",
    "prod:check-env": "node scripts/production/check-env.js",
    "prod:smoke": "node scripts/production/smoke-test.js",
    "db:up": "docker compose -f infra/docker/docker-compose.yml up -d || docker-compose -f infra/docker/docker-compose.yml up -d",
    "start:api": "npm run dev -w services/api",
    "start:web:static": "python -m http.server 5173 --directory apps/web/dist"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
