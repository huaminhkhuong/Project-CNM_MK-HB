# ==============================================================================
# PC MALL MONOREPO ROOT CONFIGURATION TEMPLATE (.env.example)
# Sao chép file này thành .env ở thư mục gốc hoặc phân bổ vào services/api/.env và apps/web/.env
# ==============================================================================

# ── 1. MÔI TRƯỜNG & CỔNG ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# ── 2. CƠ SỞ DỮ LIỆU MYSQL (DOCKER CONTAINER cnm_mysql) ──────────────────────
DATABASE_URL=mysql://root:root@127.0.0.1:3307/cnm_mk_hb
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=cnm_mk_hb
DB_USER=root
DB_PASSWORD=root

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=cnm_mk_hb
MYSQL_USER=root
MYSQL_PASSWORD=root

# ── 3. BẢO MẬT XÁC THỰC JWT (JSON WEB TOKEN) ──────────────────────────────────
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── 4. CẤU HÌNH AI LLM DUY NHẤT (UNIFIED LLM ADAPTER) ─────────────────────────
# Quản lý LLM tập trung tại một nơi duy nhất:
#   - gemini   : Google Gemini (gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
#   - groq     : Groq Cloud (llama-3.3-70b-versatile, mixtral-8x7b-32768)
#   - deepseek : DeepSeek (deepseek-chat, deepseek-reasoner)
#   - openai   : OpenAI (gpt-4o-mini, gpt-4o)
#   - ollama   : Máy chủ Local (llama3, mistral - qua LLM_ENDPOINT)
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-1.5-flash
LLM_ENDPOINT=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

GEMINI_API_KEY=
GROQ_API_KEY=

# ── 5. CỔNG THANH TOÁN (VNPAY & MOMO) ─────────────────────────────────────────
PAYMENT_MOCK_MODE=true
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/create

# ── 6. VẬN CHUYỂN & GIAO HÀNG (SHIPPING) ──────────────────────────────────────
SHIPPING_MOCK_MODE=true
SHIPPING_PROVIDER=manual

# ── 7. EMAIL & THÔNG BÁO (NODEMAILER SMTP) ────────────────────────────────────
MAIL_USER=your_smtp_email@gmail.com
MAIL_PASS=your_smtp_app_password
MAIL_FROM=no-reply@pcmall.vn

# ── 8. LƯU TRỮ PHIÊN CHAT ─────────────────────────────────────────────────────
CHAT_STORAGE_PATH=./data/chat-sessions.json

# ── 9. CẤU HÌNH FRONTEND WEB (apps/web) ────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4000/api
VITE_API_URL=http://localhost:4000/api
VITE_APP_ENV=development
