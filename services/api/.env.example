# API — copy to services/api/.env
NODE_ENV=development
PORT=4000

# Prisma / MySQL (docker host port 3308 → container 3306)
DATABASE_URL=mysql://root:password@127.0.0.1:3308/cnm_mk_hb

# Legacy pool (JS modules) — optional if DATABASE_URL is set
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=cnm_mk_hb
DB_USER=root
DB_PASSWORD=password

FRONTEND_URL=http://localhost:5173

JWT_ACCESS_SECRET=change_me_access_use_long_random_string
JWT_REFRESH_SECRET=change_me_refresh_use_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
PAYMENT_MOCK_MODE=true

SHIPPING_MOCK_MODE=true
SHIPPING_PROVIDER=manual

CHAT_STORAGE_PATH=./data/chat-sessions.json
