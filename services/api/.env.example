# ==============================================================================
# PC MALL API SERVICE ENVIRONMENT TEMPLATE (.env.example)
# Sao chép file này thành .env trong thư mục services/api/ và điền các giá trị thực tế
# ==============================================================================

# ── 1. MÔI TRƯỜNG & CỔNG SERVER ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# ── 2. CƠ SỞ DỮ LIỆU MYSQL ────────────────────────────────────────────────────
# Prisma / MySQL (docker host port 3307 → container 3306)
DATABASE_URL=mysql://root:root@127.0.0.1:3307/cnm_mk_hb

# Legacy pool (JS modules) — optional if DATABASE_URL is set
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=cnm_mk_hb
DB_USER=root
DB_PASSWORD=root

# ── 3. BẢO MẬT XÁC THỰC JWT (JSON WEB TOKEN) ──────────────────────────────────
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── 4. CẤU HÌNH AI LLM DUY NHẤT (UNIFIED LLM ADAPTER) ─────────────────────────
# Thiết kế Adapter Pattern đa nhà cung cấp: Chỉ cần đổi thông số tại đây, toàn bộ
# Chatbot, AI PC Builder và Cố vấn kỹ thuật sẽ tự động chuyển sang mô hình mới.
#
# Nhà cung cấp hỗ trợ (LLM_PROVIDER): gemini | groq | deepseek | openai | ollama
#
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-1.5-flash
LLM_ENDPOINT=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Tương thích ngược:
GEMINI_API_KEY=
GROQ_API_KEY=

# ── 5. CỔNG THANH TOÁN (VNPAY & MOMO) ─────────────────────────────────────────
PAYMENT_MOCK_MODE=true
PAYMENT_TIMEOUT_MINUTES=30
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/create

# ── 6. VẬN CHUYỂN & GIAO HÀNG (SHIPPING) ──────────────────────────────────────
SHIPPING_MOCK_MODE=true
SHIPPING_PROVIDER=manual

# ── 7. EMAIL & THÔNG BÁO (NODEMAILER SMTP) ────────────────────────────────────
MAIL_USER=your_smtp_email@gmail.com
MAIL_PASS=your_smtp_app_password
MAIL_FROM=no-reply@pcmall.vn

# ── 8. LƯU TRỮ PHIÊN CHAT ─────────────────────────────────────────────────────
CHAT_STORAGE_PATH=./data/chat-sessions.json
